---
import { EMAIL, GITHUB_URL, LINKEDIN_URL, PHONE_HREF } from '../consts';

const today = new Date();

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/experience', label: 'Experience' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/skills', label: 'Skills' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/contact', label: 'Contact' },
];
---

<footer class="w-full border-t border-line bg-paper text-ink mt-8 sm:mt-12">
	<div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12 py-8 sm:py-10 space-y-8">
		<!-- Top Row: Editorial 3-Column Footer -->
		<div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
			<!-- Brand / Bio Column -->
			<div class="md:col-span-2 space-y-3">
				<a href="/" class="text-lg font-bold font-serif italic text-ink hover:text-accent transition-none">
					<span class="not-italic font-sans font-bold">Asif</span> Nawaz<span class="text-accent">.</span>
				</a>
				<p class="text-sm text-muted max-w-sm leading-relaxed font-sans">
					Senior SQA Engineer & AI Automation Architect engineering resilient, code-first test systems for web, mobile, and APIs.
				</p>
			</div>

			<!-- Navigation Column -->
			<div class="space-y-3">
				<div class="font-mono text-xs text-accent tracking-wider">
					&#40; navigate &#41;
				</div>
				<ul class="space-y-2 text-sm font-sans list-none m-0 p-0">
					{
						navLinks.map((link) => (
							<li>
								<a href={link.href} class="text-muted hover:text-ink transition-none">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Connect Column -->
			<div class="space-y-3">
				<div class="font-mono text-xs text-accent tracking-wider">
					&#40; connect &#41;
				</div>
				<ul class="space-y-2 text-sm font-sans list-none m-0 p-0">
					<li>
						<a
							href={GITHUB_URL}
							target="_blank"
							rel="noreferrer noopener"
							class="text-muted hover:text-ink transition-none inline-flex items-center gap-1.5"
						>
							<span>GitHub</span>
							<span class="text-xs text-muted">↗</span>
						</a>
					</li>
					<li>
						<a
							href={LINKEDIN_URL}
							target="_blank"
							rel="noreferrer noopener"
							class="text-muted hover:text-ink transition-none inline-flex items-center gap-1.5"
						>
							<span>LinkedIn</span>
							<span class="text-xs text-muted">↗</span>
						</a>
					</li>
					<li>
						<a
							href={`mailto:${EMAIL}`}
							class="text-muted hover:text-ink transition-none inline-flex items-center gap-1.5"
						>
							<span>Email</span>
							<span class="text-xs text-muted">→</span>
						</a>
					</li>
					<li>
						<a
							href={PHONE_HREF}
							class="text-muted hover:text-ink transition-none inline-flex items-center gap-1.5"
						>
							<span>Phone & WhatsApp</span>
							<span class="text-xs text-muted">→</span>
						</a>
					</li>
				</ul>
			</div>
		</div>

		<!-- Bottom Sub-Footer Bar -->
		<div class="pt-8 border-t border-line flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-muted">
			<div>
				&copy; {today.getFullYear()} Asif Nawaz
			</div>
			<div>
				Built with Astro 7
			</div>
		</div>
	</div>
</footer>
