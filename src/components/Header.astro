---
const pathname = Astro.url.pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';

const navItems = [
	{ href: '/', label: 'home' },
	{ href: '/about', label: 'about' },
	{ href: '/experience', label: 'experience' },
	{ href: '/projects', label: 'projects' },
	{ href: '/skills', label: 'skills' },
	{ href: '/blog', label: 'blog' },
	{ href: '/contact', label: 'contact' },
];

const isActive = (href: string) => {
	if (href === '/') {
		return currentPath === '/';
	}
	return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class="w-full border-b border-line bg-paper/90 backdrop-blur-xs sticky top-0 z-50">
	<div class="mx-auto max-w-[1440px] px-4 sm:px-8 lg:px-12 py-4 sm:py-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
		<a
			href="/"
			class="text-xl sm:text-2xl font-bold tracking-tight text-ink hover:text-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 transition-none font-serif italic"
			aria-label="Asif Nawaz - Home"
		>
			<span class="not-italic font-sans font-bold">A</span>N<span class="text-accent">.</span>
		</a>

		<nav aria-label="Main Navigation">
			<ul class="flex flex-wrap items-center gap-x-6 sm:gap-x-8 gap-y-2 text-sm list-none m-0 p-0 font-mono">
				{
					navItems.map((item) => {
						const active = isActive(item.href);
						return (
							<li class="relative pb-1">
								<a
									href={item.href}
									aria-current={active ? 'page' : undefined}
									class:list={[
										'transition-none py-1 inline-block focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2',
										active
											? 'text-ink font-semibold'
											: 'text-muted hover:text-ink',
									]}
								>
									{item.label}
								</a>
								{active && (
									<span
										class="absolute -bottom-1 left-0 w-full h-[2.5px] bg-accent block"
										aria-hidden="true"
									/>
								)}
							</li>
						);
					})
				}
			</ul>
		</nav>
	</div>
</header>
