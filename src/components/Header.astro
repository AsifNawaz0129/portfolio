---
const pathname = Astro.url.pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';

const navItems = [
	{ href: '/', label: 'Home' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/resume', label: 'Resume' },
	{ href: '/contact', label: 'Contact' },
];

const isActive = (href: string) => {
	if (href === '/') {
		return currentPath === '/';
	}
	return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class="w-full border-b border-line bg-paper">
	<div class="mx-auto max-w-3xl px-4 sm:px-6 py-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
		<a
			href="/"
			class="text-base font-semibold tracking-tight text-ink hover:text-muted focus-visible:outline-2 focus-visible:outline-ink focus-visible:outline-offset-2 transition-none"
			aria-label="Asif Nawaz - Home"
		>
			Asif Nawaz
		</a>

		<nav aria-label="Main Navigation">
			<ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm list-none m-0 p-0">
				{
					navItems.map((item) => {
						const active = isActive(item.href);
						return (
							<li>
								<a
									href={item.href}
									aria-current={active ? 'page' : undefined}
									class:list={[
										'transition-none py-1 inline-block focus-visible:outline-2 focus-visible:outline-ink focus-visible:outline-offset-2',
										active
											? 'text-ink font-medium underline underline-offset-4 decoration-ink'
											: 'text-muted hover:text-ink no-underline',
									]}
								>
									{item.label}
								</a>
							</li>
						);
					})
				}
			</ul>
		</nav>
	</div>
</header>
