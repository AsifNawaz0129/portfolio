---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { EMAIL, GITHUB_URL, LINKEDIN_URL, SITE_ROLE, SITE_URL } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags = [] } = Astro.props;

const currentUrl = Astro.url.toString();
const encodedUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(`${title} | Asif Nawaz`);
const linkedInShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const twitterShareUrl = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const techArticleSchema = {
	'@context': 'https://schema.org',
	'@type': 'TechArticle',
	headline: title,
	description: description,
	image: heroImage ? new URL(heroImage.src, Astro.url).toString() : undefined,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate || pubDate).toISOString(),
	author: {
		'@type': 'Person',
		name: 'Asif Nawaz',
		jobTitle: SITE_ROLE,
		url: Astro.site?.toString() ?? SITE_URL,
		sameAs: [LINKEDIN_URL, GITHUB_URL],
	},
	publisher: {
		'@type': 'Person',
		name: 'Asif Nawaz',
		url: Astro.site?.toString() ?? SITE_URL,
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': currentUrl,
	},
	keywords: tags.join(', '),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Asif Nawaz`} description={description} image={heroImage?.src || '/og-image.png'} />
		<script type="application/ld+json" set:html={JSON.stringify(techArticleSchema)} />
	</head>

	<body class="bg-paper text-ink selection:bg-accent-subtle selection:text-accent">
		<Header />

		<main class="w-full max-w-4xl mx-auto px-4 sm:px-8 lg:px-12 py-8 sm:py-16 space-y-10 sm:space-y-12">
			<!-- Back to Blog Link -->
			<div>
				<a
					href="/blog"
					class="group inline-flex items-center gap-2 text-xs font-mono text-muted hover:text-ink transition-colors duration-200"
				>
					<span class="text-accent transition-transform duration-200 group-hover:-translate-x-1">←</span>
					<span>Back to all articles</span>
				</a>
			</div>

			<!-- Article Header -->
			<header class="space-y-6 border-b border-line pb-8 sm:pb-10">
				<!-- Meta: Date, Tags -->
				<div class="flex flex-wrap items-center gap-3">
					<div class="text-xs font-mono text-muted">
						<FormattedDate date={pubDate} />
					</div>
					{
						updatedDate && (
							<div class="text-xs font-mono text-muted italic">
								(Updated <FormattedDate date={updatedDate} />)
							</div>
						)
					}
					{
						tags.map((tag) => (
							<span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono border border-line bg-paper-card text-accent font-medium">
								#{tag}
							</span>
						))
					}
				</div>

				<!-- Title -->
				<h1 class="text-3xl sm:text-5xl md:text-6xl font-bold font-serif text-ink tracking-tight leading-tight">
					{title}
				</h1>

				<!-- Description Lead -->
				<p class="text-base sm:text-xl text-muted font-sans leading-relaxed">
					{description}
				</p>

				<!-- Author & Social Share Row -->
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-4 border-t border-line/60">
					<!-- Author Card -->
					<div class="flex items-center gap-3">
						<div class="w-10 h-10 rounded-full bg-ink text-paper font-serif font-bold flex items-center justify-center text-sm shadow-2xs">
							AN
						</div>
						<div>
							<div class="text-sm font-bold font-sans text-ink">Asif Nawaz</div>
							<div class="text-xs font-mono text-muted">{SITE_ROLE}</div>
						</div>
					</div>

					<!-- Social Share Toolbar -->
					<div class="flex items-center gap-2" aria-label="Share this article">
						<span class="text-xs font-mono text-muted mr-1">Share:</span>
						<!-- LinkedIn Share Button -->
						<a
							href={linkedInShareUrl}
							target="_blank"
							rel="noreferrer noopener"
							class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-line bg-paper-card text-xs font-mono text-muted hover:text-ink hover:border-ink transition-all duration-200 shadow-2xs"
							title="Share on LinkedIn"
						>
							<svg class="w-3.5 h-3.5 text-[#0A66C2]" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.65 1.65 0 0 0-1.66 1.65 1.66 1.66 0 0 0 1.66 1.66 1.66 1.66 0 0 0 1.65-1.66c0-.92-.74-1.65-1.65-1.65Z"/></svg>
							<span>LinkedIn</span>
						</a>

						<!-- Twitter / X Share Button -->
						<a
							href={twitterShareUrl}
							target="_blank"
							rel="noreferrer noopener"
							class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-line bg-paper-card text-xs font-mono text-muted hover:text-ink hover:border-ink transition-all duration-200 shadow-2xs"
							title="Share on X"
						>
							<svg class="w-3 h-3 text-ink" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
							<span>Post</span>
						</a>
					</div>
				</div>
			</header>

			<!-- Article Prose Content -->
			<article class="prose max-w-none text-ink font-sans text-base sm:text-lg leading-relaxed">
				<slot />
			</article>

			<!-- Post Footer / Author Bio & Share -->
			<footer class="pt-10 border-t border-line space-y-8">
				<!-- Author Bio Card -->
				<div class="p-6 sm:p-8 rounded-2xl border border-line bg-paper-card flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 shadow-2xs">
					<div class="flex items-center gap-4">
						<div class="w-14 h-14 rounded-full bg-ink text-paper font-serif font-bold flex items-center justify-center text-xl shrink-0 shadow-2xs">
							AN
						</div>
						<div class="space-y-1">
							<h3 class="text-lg font-bold font-serif text-ink">Written by Asif Nawaz</h3>
							<p class="text-xs sm:text-sm text-muted font-sans max-w-md">
								Senior SQA Engineer & AI Automation Architect with 8+ years building enterprise test infrastructure in Playwright, Cypress, and CI/CD matrices.
							</p>
						</div>
					</div>

					<div class="flex items-center gap-3">
						<a
							href={LINKEDIN_URL}
							target="_blank"
							rel="noreferrer noopener"
							class="group inline-flex items-center gap-2 px-4 py-2 rounded-full border border-line bg-paper text-ink text-xs font-mono hover:border-ink transition-all duration-200"
						>
							<span>LinkedIn</span>
							<span class="text-xs">↗</span>
						</a>
						<a
							href={GITHUB_URL}
							target="_blank"
							rel="noreferrer noopener"
							class="group inline-flex items-center gap-2 px-4 py-2 rounded-full border border-line bg-paper text-ink text-xs font-mono hover:border-ink transition-all duration-200"
						>
							<span>GitHub</span>
							<span class="text-xs">↗</span>
						</a>
					</div>
				</div>

				<!-- Share Toolbar Footer -->
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-4">
					<div class="text-sm font-mono text-muted">
						Found this useful? Share it with fellow engineers:
					</div>
					<div class="flex items-center gap-3">
						<a
							href={linkedInShareUrl}
							target="_blank"
							rel="noreferrer noopener"
							class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-ink text-paper text-xs font-mono font-medium hover:bg-accent transition-all duration-200 shadow-sm"
						>
							<span>Share on LinkedIn</span>
							<span>↗</span>
						</a>
						<a
							href="/blog"
							class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-line bg-paper-card text-ink text-xs font-mono hover:border-ink transition-all duration-200"
						>
							<span>More Articles</span>
							<span>→</span>
						</a>
					</div>
				</div>
			</footer>
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	/* Code syntax comment contrast for WCAG AA */
	.astro-code span[style*="color:#6A737D"],
	.astro-code span[style*="color:#6a737d"] {
		color: #9ca3af !important;
	}

	/* Warm Editorial Prose Typography */
	.prose h1, .prose h2, .prose h3, .prose h4 {
		font-family: var(--font-serif, "Charter", "Georgia", serif);
		color: var(--color-ink);
		letter-spacing: -0.015em;
	}

	.prose h2 {
		font-size: 1.85rem;
		font-weight: 700;
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		line-height: 1.25;
		border-bottom: 1px solid var(--color-line);
		padding-bottom: 0.5rem;
	}

	.prose h3 {
		font-size: 1.4rem;
		font-weight: 600;
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		line-height: 1.3;
	}

	.prose p {
		margin-bottom: 1.35rem;
		color: var(--color-ink);
		line-height: 1.85;
		font-size: 1.0625rem;
	}

	.prose ul, .prose ol {
		margin-top: 0.75rem;
		margin-bottom: 1.35rem;
		padding-left: 1.5rem;
	}

	.prose li {
		margin-bottom: 0.6rem;
		color: var(--color-ink);
		line-height: 1.75;
		font-size: 1.0625rem;
	}

	.prose a {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 3px;
		transition: color 0.15s ease;
	}

	.prose a:hover {
		color: var(--color-accent-hover);
	}

	.prose code {
		font-family: var(--font-mono, 'JetBrains Mono Variable', monospace);
		font-size: 0.875em;
		background-color: var(--color-paper-card);
		border: 1px solid var(--color-line);
		padding: 0.2em 0.45em;
		border-radius: 0.375rem;
		color: var(--color-accent);
	}

	.prose pre {
		background-color: #141416 !important;
		color: #f4f4f5 !important;
		border: 1px solid var(--color-line);
		border-radius: 0.75rem;
		padding: 1.25rem;
		margin-top: 1.5rem;
		margin-bottom: 1.5rem;
		overflow-x: auto;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
	}

	.prose pre code {
		background-color: transparent !important;
		border: none !important;
		padding: 0 !important;
		color: inherit !important;
		font-size: 0.875rem;
	}

	.prose blockquote {
		border-left: 3px solid var(--color-accent);
		background-color: var(--color-accent-subtle);
		padding: 1rem 1.25rem;
		margin: 1.75rem 0;
		border-radius: 0 0.5rem 0.5rem 0;
		font-style: italic;
		color: var(--color-ink);
	}

	.prose strong {
		color: var(--color-ink);
		font-weight: 600;
	}

	.prose table {
		width: 100%;
		border-collapse: separate;
		border-spacing: 0;
		margin: 2rem 0;
		border-radius: 0.75rem;
		overflow: hidden;
		border: 1px solid var(--color-line);
		background-color: var(--color-paper-card);
		font-size: 0.875rem;
		box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
	}

	.prose thead {
		background-color: var(--color-paper);
	}

	.prose th {
		padding: 0.85rem 1.15rem;
		text-align: left;
		font-weight: 700;
		font-family: var(--font-mono, monospace);
		color: var(--color-ink);
		border-bottom: 1px solid var(--color-line);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.prose td {
		padding: 0.85rem 1.15rem;
		border-bottom: 1px solid var(--color-line);
		color: var(--color-ink);
		vertical-align: top;
		line-height: 1.6;
	}

	.prose tr:last-child td {
		border-bottom: none;
	}

	.prose tr:hover td {
		background-color: var(--color-paper);
	}

	.prose hr {
		border-color: var(--color-line);
		margin: 2.25rem 0;
	}
</style>
