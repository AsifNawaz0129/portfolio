---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { EMAIL, GITHUB_URL, LINKEDIN_URL, SITE_ROLE, SITE_TITLE } from '../consts';

const projects = [
	{
		title: 'Testim.io Automation & QA Suite',
		category: 'Enterprise SaaS QA',
		year: '2023 — Present',
		company: 'Enterprise SaaS Platform · London, UK (Remote)',
		impact: '+60% Coverage / -45% Feedback Loop',
		description:
			'Architected custom automation wrapper libraries and test components, maintained automated Testim.io suites using JavaScript for custom logic, and engineered parallel GitLab CI test execution matrices.',
		tags: ['Testim.io', 'JavaScript', 'TypeScript', 'GitLab CI', 'Maestro', 'Docker'],
		highlights: [
			'Expanded automated E2E regression coverage by 60% across distributed enterprise web platforms',
			'Designed parallel test execution matrices in GitLab CI using TypeScript, reducing pipeline feedback loops by 45%',
			'Implemented cross-platform mobile automation using Maestro for both iOS and Android platforms',
		],
		gradient: 'from-amber-500/10 via-orange-500/5 to-transparent',
		badgeColor: 'border-orange-300/80 bg-orange-100/70 text-orange-900 dark:border-orange-500/30 dark:bg-orange-950/50 dark:text-orange-300',
	},
	{
		title: 'React Native Mobile Automation Framework',
		category: 'Mobile SDET',
		year: '2022 — 2023',
		company: 'Rayn · Islamabad, Pakistan',
		impact: '99% Pass Rate / 50% Faster Execution',
		description:
			'Built a modular, cross-platform mobile test automation framework from scratch for React Native applications utilizing Appium, Webdriver.io, and Node.js with Component Object Model (COM) architecture.',
		tags: ['Appium', 'Webdriver.io', 'React Native', 'Node.js', 'Postman', 'ClickUp'],
		highlights: [
			'Implemented Component Object Model (COM) decoupling UI layers into isolated, maintainable components',
			'Increased automated regression safety bounds by 50% while cutting test execution cycles in half',
			'Executed robust API contract testing with Postman and Swagger for frontend-to-backend microservices',
		],
		gradient: 'from-blue-500/10 via-indigo-500/5 to-transparent',
		badgeColor: 'border-blue-300/80 bg-blue-100/70 text-blue-900 dark:border-blue-500/30 dark:bg-blue-950/50 dark:text-blue-300',
	},
	{
		title: 'Cypress & TypeScript with Generative AI Automation',
		category: 'Web QA & Gen AI',
		year: '2024',
		company: 'Enterprise Test Suite Project',
		impact: 'Accelerated Test Scripting & Autonomous Docs',
		description:
			'Designed and implemented an automated end-to-end test suite for modern web applications utilizing Cypress and TypeScript, leveraging Generative AI agents to write test scripts and generate comprehensive test documentation.',
		tags: ['Cypress', 'TypeScript', 'Generative AI', 'AI Test Agents', 'Node.js'],
		highlights: [
			'Leveraged Generative AI agents to assist in writing test scripts and generating comprehensive test documentation',
			'Built custom Cypress commands and reusable assertion helpers for complex dynamic web workflows',
			'Integrated into GitHub Actions CI pipeline for automated pull request quality gates',
		],
		gradient: 'from-emerald-500/10 via-teal-500/5 to-transparent',
		badgeColor: 'border-emerald-300/80 bg-emerald-100/70 text-emerald-900 dark:border-emerald-500/30 dark:bg-emerald-950/50 dark:text-emerald-300',
	},
	{
		title: 'Java & Selenium WebDriver E2E Automation Framework',
		category: 'Enterprise Automation',
		year: '2021 — 2024',
		company: 'Quality Engineering Labs',
		impact: 'AI-Driven Defect Investigation & Reporting',
		description:
			'Architected a robust, scalable E2E automation framework from scratch using Java and Selenium WebDriver. Integrated Maven, TestNG, and Extent Reports with AI-driven bug analysis tools to accelerate defect resolution cycles.',
		tags: ['Selenium WebDriver', 'Java', 'TestNG', 'Maven', 'Extent Reports', 'AI Triage'],
		highlights: [
			'Engineered Page Object Model (POM) architecture with thread-safe parallel test execution in TestNG',
			'Integrated AI-assisted bug investigation to capture stack traces, console errors, and reproduction steps',
			'Automated cross-browser execution across Chrome, Firefox, Edge, and Safari environments',
		],
		gradient: 'from-purple-500/10 via-violet-500/5 to-transparent',
		badgeColor: 'border-purple-300/80 bg-purple-100/70 text-purple-900 dark:border-purple-500/30 dark:bg-purple-950/50 dark:text-purple-300',
	},
	{
		title: 'Maestro Mobile Automation & AI Self-Healing Suite',
		category: 'Mobile QA Innovation',
		year: '2023 — Present',
		company: 'Mobile Quality Suite',
		impact: 'Zero-Flakiness High-Velocity UI Testing',
		description:
			'Developed a dedicated mobile automation suite using Maestro to streamline testing for high-velocity UI updates, utilizing AI to maintain test stability and self-heal element locators across different mobile device configurations.',
		tags: ['Maestro', 'iOS', 'Android', 'Self-Healing Locators', 'Mobile QA'],
		highlights: [
			'Streamlined cross-platform UI flows on native iOS and Android builds with declarative YAML test flows',
			'Utilized AI-assisted heuristics to recover dynamic locators during rapid application UI redesigns',
			'Achieved sub-minute mobile smoke test execution on emulator and cloud device matrices',
		],
		gradient: 'from-amber-500/10 via-stone-500/5 to-transparent',
		badgeColor: 'border-stone-300/80 bg-stone-100/70 text-stone-900 dark:border-stone-500/30 dark:bg-stone-900/60 dark:text-stone-300',
	},
	{
		title: 'Apache JMeter Enterprise Load & Stress Benchmark Suite',
		category: 'Performance Engineering',
		year: '2019 — Present',
		company: 'Enterprise Benchmarking',
		impact: 'Peak Traffic Latency SLAs Guaranteed',
		description:
			'Designed and executed distributed stress, endurance, and spike testing suites using Apache JMeter to validate server capacity, response latency, and database connection pooling under peak operational stress.',
		tags: ['Apache JMeter', 'Performance Testing', 'Load Benchmarking', 'Docker', 'AWS'],
		highlights: [
			'Simulated realistic concurrent user journeys with dynamic parameterization and assertion verification',
			'Uncovered memory leaks, slow database queries, and thread locks before high-traffic production rollouts',
			'Generated comprehensive latency, error-rate, and throughput benchmark reports for stakeholders',
		],
		gradient: 'from-rose-500/10 via-pink-500/5 to-transparent',
		badgeColor: 'border-rose-300/80 bg-rose-100/70 text-rose-900 dark:border-rose-500/30 dark:bg-rose-950/50 dark:text-rose-300',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Projects & QA Frameworks | ${SITE_TITLE}`}
			description="Explore selected QA automation architectures, enterprise frameworks, mobile testing suites, and AI-driven quality engineering projects built by Asif Nawaz."
		/>
	</head>
	<body class="bg-paper text-ink selection:bg-accent-subtle selection:text-accent">
		<Header />

		<main class="w-full max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12 pt-4 sm:pt-6 pb-2 sm:pb-4 space-y-10 sm:space-y-12">
			<!-- Header Section -->
			<section class="space-y-4 pt-2" aria-labelledby="projects-heading">
				<div class="font-mono text-xs sm:text-sm text-accent tracking-wide">
					&#40; featured work &#41;
				</div>
				<div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
					<div>
						<h1
							id="projects-heading"
							class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-ink font-serif leading-none"
						>
							<span class="italic text-accent font-serif font-normal inline-block relative">
								Selected
								<svg class="absolute -bottom-2 sm:-bottom-3 left-0 w-full h-3 text-accent pointer-events-none overflow-visible" viewBox="0 0 100 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
									<path d="M 2 6 Q 25 12, 50 6 T 98 6" />
								</svg>
							</span> Projects
						</h1>
						<p class="text-base sm:text-lg text-muted max-w-2xl font-sans mt-4 leading-relaxed">
							A curated collection of production QA automation frameworks, mobile testing engines, performance benchmark suites, and AI quality workflows engineered across enterprise platforms.
						</p>
					</div>

					<!-- Counter Badge -->
					<div class="hidden sm:flex items-center gap-2 px-4 py-2 rounded-full border border-line bg-paper-card text-xs font-mono text-muted shadow-2xs self-start md:self-end">
						<span class="w-2 h-2 rounded-full bg-accent inline-block animate-pulse"></span>
						<span>6 PRODUCTION FRAMEWORKS</span>
					</div>
				</div>
			</section>

			<!-- Projects Grid (3-column, compact, no empty spaces) -->
			<section aria-label="Projects Collection" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
				{
					projects.map((project) => (
						<article class="group rounded-2xl border border-line bg-paper-card p-6 sm:p-7 flex flex-col justify-between hover:border-ink/40 transition-all duration-300 shadow-2xs hover:shadow-md relative overflow-hidden">
							<!-- Subtle Header Accent Background -->
							<div class:list={['absolute top-0 left-0 right-0 h-28 bg-gradient-to-b opacity-60 pointer-events-none', project.gradient]} />

							<div class="space-y-5 relative z-10">
								<!-- Card Top Meta -->
								<div class="flex items-center justify-between gap-2">
									<span class:list={['px-2.5 py-1 rounded-full text-[11px] font-mono font-medium border', project.badgeColor]}>
										{project.category}
									</span>
									<span class="text-xs font-mono text-muted">
										{project.year}
									</span>
								</div>

								<!-- Company Attribution -->
								<div class="text-xs font-mono text-muted flex items-center gap-1.5 -mt-2">
									<span>🏢</span>
									<span>{project.company}</span>
								</div>

								<!-- Title & Impact Metric -->
								<div class="space-y-2">
									<h2 class="text-xl font-bold text-ink font-sans group-hover:text-accent transition-colors duration-200">
										{project.title}
									</h2>
									<div class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-accent bg-accent/5 px-2.5 py-1 rounded-md border border-accent/20">
										<span>⚡</span>
										<span>{project.impact}</span>
									</div>
								</div>

								<!-- Narrative Description -->
								<p class="text-sm text-muted leading-relaxed font-sans">
									{project.description}
								</p>

								<!-- Key Architecture Highlights -->
								<ul class="space-y-2 text-xs text-ink/90 font-sans border-t border-line/60 pt-4">
									{project.highlights.map((highlight) => (
										<li class="flex items-start gap-2">
											<span class="text-accent font-bold mt-0.5">•</span>
											<span>{highlight}</span>
										</li>
									))}
								</ul>
							</div>

							<!-- Tech Stack Badges -->
							<div class="pt-6 relative z-10 border-t border-line/60 mt-6 flex flex-wrap gap-1.5">
								{project.tags.map((tag) => (
									<span class="px-2 py-0.5 rounded-md bg-paper border border-line text-[11px] font-mono text-muted">
										{tag}
									</span>
								))}
							</div>
						</article>
					))
				}
			</section>

			<!-- Bottom CTA Banner with Pipeline Architecture Flowchart -->
			<section
				class="p-8 sm:p-12 lg:p-14 rounded-3xl border border-line bg-paper-card relative overflow-hidden shadow-2xs grid grid-cols-1 lg:grid-cols-12 gap-8 items-center"
				aria-labelledby="cta-heading"
			>
				<div class="lg:col-span-7 space-y-5 relative z-10">
					<div class="space-y-2">
						<div class="font-mono text-xs text-accent tracking-wide">
							&#40; collaborate &#41;
						</div>
						<h2
							id="cta-heading"
							class="text-3xl sm:text-4xl lg:text-5xl font-bold font-serif text-ink tracking-tight"
						>
							Let’s build <span class="italic text-accent font-normal">bulletproof systems.</span>
						</h2>
					</div>

					<p class="text-sm sm:text-base text-muted max-w-lg leading-relaxed">
						Looking to architect an enterprise automation test suite, modernize your CI/CD pipelines, or benchmark application performance? Reach out to collaborate.
					</p>

					<div class="flex flex-wrap items-center gap-3.5 pt-2">
						<a
							href="/contact"
							class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-ink text-paper text-sm font-medium hover:bg-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 transition-all duration-200 shadow-sm"
						>
							<span class="text-paper font-medium">Get in Touch</span>
							<span class="text-paper font-medium">→</span>
						</a>
						<a
							href={GITHUB_URL}
							target="_blank"
							rel="noreferrer noopener"
							class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-line bg-paper text-ink text-sm font-medium hover:border-ink focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 transition-none"
						>
							<span class="text-ink font-medium">GitHub Work</span>
							<span class="text-xs text-accent font-mono font-bold">↗</span>
						</a>
					</div>
				</div>

				<!-- Right Pipeline Architecture Flowchart SVG -->
				<div class="lg:col-span-5 flex items-center justify-center relative select-none" aria-hidden="true">
					<div class="w-full max-w-[420px] aspect-[2/1] flex items-center justify-center">
						<svg class="w-full h-full" viewBox="0 0 360 160" fill="none">
							<path d="M 30 80 L 95 80 L 175 80 L 255 80 L 320 80" stroke="#e5e1d8" stroke-width="2" />
							<path d="M 95 80 C 120 30, 230 30, 255 80" stroke="#e5e1d8" stroke-width="1.5" stroke-dasharray="4 4" />
							<path d="M 95 80 C 120 130, 230 130, 255 80" stroke="#e5e1d8" stroke-width="1.5" stroke-dasharray="4 4" />
							<circle cx="30" cy="80" r="3.5" fill="#c0441f" class="animate-pulse" />

							<!-- Nodes -->
							<g transform="translate(30, 80)">
								<circle cx="0" cy="0" r="14" fill="#f8f6f0" stroke="#e5e1d8" stroke-width="1.5" />
								<circle cx="0" cy="0" r="5" fill="#c0441f" />
							</g>
							<g transform="translate(100, 80)">
								<circle cx="0" cy="0" r="20" fill="#f8f6f0" stroke="#e5e1d8" stroke-width="1.5" />
								<path d="M -8 -6 C -8 -9, 8 -9, 8 -6 C 8 -3, -8 -3, -8 -6 Z" stroke="#66635e" stroke-width="1.2" fill="none" />
								<path d="M -8 -6 L -8 6 C -8 9, 8 9, 8 6 L 8 -6" stroke="#66635e" stroke-width="1.2" fill="none" />
								<path d="M -8 0 C -8 3, 8 3, 8 0" stroke="#66635e" stroke-width="1.2" fill="none" />
							</g>
							<g transform="translate(180, 80)">
								<circle cx="0" cy="0" r="22" fill="#f8f6f0" stroke="#c0441f" stroke-width="1.5" filter="drop-shadow(0 2px 8px rgba(192,68,31,0.12))" />
								<circle cx="0" cy="0" r="3" fill="#c0441f" />
								<circle cx="-6" cy="-6" r="2" fill="#66635e" />
								<circle cx="-6" cy="6" r="2" fill="#66635e" />
								<circle cx="6" cy="0" r="2" fill="#66635e" />
								<line x1="-4" y1="-4" x2="-1" y2="-1" stroke="#66635e" stroke-width="1" />
								<line x1="-4" y1="4" x2="-1" y2="1" stroke="#66635e" stroke-width="1" />
								<line x1="2" y1="0" x2="4" y2="0" stroke="#66635e" stroke-width="1" />
							</g>
							<g transform="translate(260, 80)">
								<circle cx="0" cy="0" r="20" fill="#f8f6f0" stroke="#e5e1d8" stroke-width="1.5" />
								<path d="M -7 2 A 4 4 0 0 1 -3 -3 A 6 6 0 0 1 5 -2 A 4 4 0 0 1 7 2 Z" stroke="#66635e" stroke-width="1.2" fill="none" />
								<line x1="0" y1="4" x2="0" y2="-1" stroke="#c0441f" stroke-width="1.2" />
								<polyline points="-2 1 0 -1 2 1" stroke="#c0441f" stroke-width="1.2" fill="none" />
							</g>
							<g transform="translate(325, 80)">
								<circle cx="0" cy="0" r="14" fill="#f8f6f0" stroke="#e5e1d8" stroke-width="1.5" />
								<polyline points="-4 0 -1 3 4 -2" stroke="#16a34a" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
							</g>
						</svg>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
