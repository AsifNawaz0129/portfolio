---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { EMAIL, GITHUB_URL, LINKEDIN_URL, PHONE, PHONE_HREF, SITE_ROLE, SITE_TITLE } from '../consts';

const contactMethods = [
	{
		label: 'Direct Email',
		value: EMAIL,
		href: `mailto:${EMAIL}`,
		description: 'Best for project inquiries, consulting requests, or QA leadership opportunities.',
		badge: 'PRIMARY',
		actionText: 'Send an email',
	},
	{
		label: 'Phone & WhatsApp',
		value: PHONE,
		href: PHONE_HREF,
		description: 'Available for direct calls, interview discussions, and WhatsApp messaging.',
		badge: 'DIRECT CALL',
		actionText: 'Call now',
	},
	{
		label: 'LinkedIn',
		value: 'linkedin.com/in/asifnawaz2311',
		href: LINKEDIN_URL,
		description: 'Connect for professional networking, recommendations, and industry updates.',
		badge: 'CONNECT',
		actionText: 'View profile',
	},
	{
		label: 'GitHub',
		value: 'github.com/AsifNawaz0129',
		href: GITHUB_URL,
		description: 'Explore public repositories, open source automation frameworks, and code samples.',
		badge: 'CODE',
		actionText: 'View repositories',
	},
];

const highlights = [
	{
		title: 'Available for Remote Roles',
		desc: 'Open to Full-Time Senior SDET, QA Lead, and Automation Architect roles across global timezones.',
	},
	{
		title: 'QA Consulting & Audits',
		desc: 'Available for advising on test architecture, CI/CD parallelization, and AI test integration.',
	},
	{
		title: 'Direct PDF Resume',
		desc: 'Download the comprehensive single-page resume with verified career milestones & technical stack.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Contact | ${SITE_TITLE}`}
			description="Get in touch with Asif Nawaz, Senior SQA Engineer & AI Automation Architect. Open for remote roles, QA consulting, and technical collaborations."
		/>
	</head>
	<body class="bg-paper text-ink selection:bg-accent-subtle selection:text-accent">
		<Header />

		<main class="w-full max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12 pt-4 sm:pt-6 pb-2 sm:pb-4 space-y-10 sm:space-y-12">
			<!-- Header Section -->
			<section class="space-y-4 pt-2" aria-labelledby="contact-heading">
				<div class="flex items-center gap-3">
					<span class="font-mono text-xs text-accent tracking-wider font-semibold">&#40; get in touch &#41;</span>
					<span class="status-badge-avail inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono bg-emerald-500/10 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-500/20 dark:border-emerald-500/40">
						<span class="w-1.5 h-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400 animate-pulse"></span>
						AVAILABLE FOR WORK
					</span>
				</div>
				<h1
					id="contact-heading"
					class="font-serif text-3xl sm:text-5xl lg:text-6xl font-normal tracking-tight text-ink leading-tight"
				>
					Let&rsquo;s build robust, <span class="italic font-serif text-accent inline-block relative">
						fail-safe
						<svg class="absolute -bottom-2 sm:-bottom-3 left-0 w-full h-3 text-accent pointer-events-none overflow-visible" viewBox="0 0 100 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
							<path d="M 2 6 Q 25 12, 50 6 T 98 6" />
						</svg>
					</span> software together.
				</h1>
				<p class="font-sans text-base sm:text-lg text-muted max-w-2xl leading-relaxed">
					Whether you are looking to scale your automated test suite, reduce CI/CD feedback cycles, or integrate AI self-healing automation, I would love to connect.
				</p>
			</section>

			<!-- Contact Cards Grid -->
			<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" aria-label="Contact channels">
				{
					contactMethods.map((method) => (
						<div class="p-6 bg-paper-card border border-line rounded-2xl flex flex-col justify-between space-y-6 hover:border-accent/40 shadow-2xs hover:shadow-sm transition-all duration-300 group">
							<div class="space-y-3">
								<div class="flex items-center justify-between">
									<span class="font-mono text-xs text-accent font-semibold tracking-wider">
										&#91; {method.badge} &#93;
									</span>
									<span class="font-mono text-xs text-muted group-hover:text-accent transition-colors">↗</span>
								</div>
								<h2 class="font-serif text-xl font-bold text-ink group-hover:text-accent transition-colors">
									{method.label}
								</h2>
								<p class="font-sans text-sm text-muted leading-relaxed">
									{method.description}
								</p>
							</div>

							<div class="pt-4 border-t border-line/60">
								<a
									href={method.href}
									target={method.href.startsWith('mailto:') || method.href.startsWith('tel:') ? undefined : '_blank'}
									rel={method.href.startsWith('mailto:') || method.href.startsWith('tel:') ? undefined : 'noreferrer noopener'}
									class="inline-flex items-center gap-2 font-mono text-xs sm:text-sm font-medium text-ink hover:text-accent transition-colors break-all"
								>
									<span>{method.value}</span>
									<span class="text-accent">&rarr;</span>
								</a>
							</div>
						</div>
					))
				}
			</section>

			<!-- Working Together / Offerings -->
			<section class="p-8 sm:p-12 lg:p-14 bg-paper-card border border-line rounded-3xl space-y-8 shadow-2xs" aria-labelledby="collaboration-heading">
				<div class="space-y-2">
					<div class="font-mono text-xs text-accent font-semibold tracking-wider">
						&#40; opportunities &#41;
					</div>
					<h2 id="collaboration-heading" class="font-serif text-2xl sm:text-3xl font-bold text-ink">
						How we can collaborate
					</h2>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					{
						highlights.map((item, idx) => (
							<div class="space-y-2.5 p-5 bg-paper/70 border border-line/60 rounded-2xl hover:border-accent/30 transition-colors">
								<div class="font-mono text-xs font-bold text-accent">
									0{idx + 1}
								</div>
								<h3 class="font-serif text-lg font-bold text-ink">
									{item.title}
								</h3>
								<p class="font-sans text-sm text-muted leading-relaxed">
									{item.desc}
								</p>
							</div>
						))
					}
				</div>

				<div class="pt-4 border-t border-line flex flex-wrap items-center gap-4">
					<a
						href={`mailto:${EMAIL}?subject=Discussion%20-%20SQA%20%2F%20SDET%20Opportunity`}
						class="inline-flex items-center gap-2 px-7 py-3.5 bg-ink text-paper rounded-full font-mono text-xs sm:text-sm font-medium hover:bg-accent hover:text-white transition-all duration-300 shadow-sm"
					>
						<span>Send Email</span>
						<span>&rarr;</span>
					</a>
					<a
						href={PHONE_HREF}
						class="inline-flex items-center gap-2 px-6 py-3.5 bg-transparent text-ink border border-line rounded-full font-mono text-xs sm:text-sm font-medium hover:border-ink transition-all duration-200 shadow-2xs"
					>
						<span>Call / WhatsApp</span>
						<span class="text-xs">&rarr;</span>
					</a>
					<a
						href="/Asif-Nawaz-Resume.pdf"
						download="Asif-Nawaz-Resume.pdf"
						class="inline-flex items-center gap-2 px-6 py-3.5 bg-transparent text-ink border border-line rounded-full font-mono text-xs sm:text-sm font-medium hover:border-ink transition-all duration-200 shadow-2xs"
					>
						<span>Download Resume (PDF)</span>
						<span class="text-xs">&darr;</span>
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

