	}

	/* Infinite Horizontal Marquee Slider */
	@keyframes marqueeSlide {
		0% {
			transform: translateX(0%);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marqueeSlide 24s linear infinite;
		will-change: transform;
	}

	.marquee-track:hover {
		animation-play-state: paused;
	}

	/* Typewriter Cursor Blinking */
	@keyframes cursorBlink {
		0%, 49% {
			opacity: 1;
		}
		50%, 100% {
			opacity: 0;
		}
	}

	.animate-cursor-blink {
		animation: cursorBlink 0.9s cubic-bezier(1, 0, 0, 1) infinite;
	}
</style>
