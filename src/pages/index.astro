---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { EMAIL, GITHUB_URL, LINKEDIN_URL, SITE_DESCRIPTION, SITE_ROLE, SITE_TITLE } from '../consts';

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Asif Nawaz',
	jobTitle: SITE_ROLE,
	description: SITE_DESCRIPTION,
	url: Astro.site?.toString() ?? 'https://asifnawaz.com',
	sameAs: [GITHUB_URL, LINKEDIN_URL],
	knowsAbout: [
		'Software Quality Assurance',
		'Test Automation',
		'Playwright',
		'Cypress',
		'Selenium WebDriver',
		'Appium',
		'CI/CD Pipelines',
		'GitLab CI',
		'Performance Testing',
		'AI-Driven QA',
	],
};

const tickerItems = [
	'Enterprise QA',
	'Playwright & Cypress',
	'GitLab CI / CD',
	'AI-Driven Testing',
	'ISTQB Certified',
	'Selenium & Appium',
	'Performance Engineering',
];

const metrics = [
	{ value: '8+', label: 'YEARS EXPERIENCE' },
	{ value: '60%', label: 'COVERAGE EXPANSION' },
	{ value: '-45%', label: 'PIPELINE FEEDBACK TIME' },
	{ value: '99%', label: 'RELEASE PASS RATE' },
];

const expertise = [
	{
		title: 'End-to-End Test Automation',
		description:
			'Architecting resilient, code-first test frameworks using Playwright, TypeScript, Cypress, and Selenium with Component Object Model (COM) patterns for web and mobile.',
		tags: ['Playwright', 'Cypress', 'Selenium', 'Appium', 'TypeScript'],
	},
	{
		title: 'CI/CD & Infrastructure',
		description:
			'Designing parallel test execution matrices in GitLab CI and GitHub Actions, slashing feedback loops by 45% with isolated test states and automated defect reporting.',
		tags: ['GitLab CI', 'GitHub Actions', 'BrowserStack', 'Docker'],
	},
	{
		title: 'AI-Driven QA & Quality Engineering',
		description:
			'Pioneering AI-driven test script validation, autonomous self-healing test suites, synthetic test data generation, and intelligent bug triage.',
		tags: ['AI-Driven QA', 'Synthetic Data', 'Self-Healing Tests', 'JMeter'],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
	</head>
	<body class="bg-paper text-ink selection:bg-accent-subtle selection:text-accent">
		<Header />

		<main class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12 sm:space-y-16">
			<!-- Hero Section -->
			<section class="space-y-6 sm:space-y-8 pt-2 sm:pt-4" aria-labelledby="hero-heading">
				<!-- Status Badge -->
				<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-300/80 bg-emerald-100/70 text-emerald-800 text-xs font-mono font-medium tracking-wide shadow-2xs">
					<span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
					OPEN TO WORK · REMOTE (GLOBAL)
				</div>

				<!-- Bracket Tag -->
				<div class="font-mono text-xs sm:text-sm text-accent tracking-wide">
					&#40; hello, i'm &#41;
				</div>

				<!-- Main Headline -->
				<div class="space-y-4">
					<h1
						id="hero-heading"
						class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight text-ink font-serif leading-none"
					>
						Asif <span class="italic text-accent font-serif font-normal">Nawaz</span>
					</h1>

					<!-- Role Tagline (Auto-rotating pure CSS) -->
					<div class="flex items-center gap-2 text-xs sm:text-sm font-mono tracking-widest text-ink uppercase pt-2">
						<span class="text-accent text-base sm:text-lg">→</span>
						<span class="inline-block h-6 overflow-hidden align-middle">
							<span class="animate-rotate-titles flex flex-col">
								<span class="h-6 flex items-center text-ink font-semibold">SENIOR SQA ENGINEER</span>
								<span class="h-6 flex items-center text-ink font-semibold">SENIOR SDET</span>
								<span class="h-6 flex items-center text-ink font-semibold">SENIOR QA AUTOMATION ENGINEER</span>
								<span class="h-6 flex items-center text-ink font-semibold">AI QA AUTOMATION ARCHITECT</span>
								<span class="h-6 flex items-center text-ink font-semibold">SENIOR SQA ENGINEER</span>
							</span>
						</span>
					</div>
				</div>

				<!-- Elevator Pitch -->
				<p class="text-base sm:text-lg text-muted max-w-3xl leading-relaxed font-sans pt-1">
					Senior Software QA Engineer and AI Automation Architect with 8+ years of experience engineering scalable, code-first test infrastructure across enterprise web, mobile, and API ecosystems. Specialized in Playwright, Cypress, CI/CD pipeline acceleration, and autonomous QA workflows.
				</p>

				<!-- Action Buttons -->
				<div class="flex flex-wrap items-center gap-4 pt-2">
					<a
						href="/resume"
						class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-full bg-ink text-paper text-sm font-medium hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 transition-none shadow-sm"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-paper" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
						<span class="text-paper font-medium">About Me</span>
					</a>
					<a
						href="/projects"
						class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-full border border-line bg-paper-card text-ink text-sm font-medium hover:border-ink focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 transition-none"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
						<span class="text-ink font-medium">View Work</span>
					</a>
					<a
						href="/contact"
						class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-full text-muted text-sm font-mono hover:text-ink transition-none"
					>
						<span>Contact me</span>
					</a>
				</div>
			</section>

			<!-- Sliding Marquee Ticker (Right to Left, Pauses on Hover) -->
			<section aria-label="Core Competencies" class="border-y border-line py-4 -mx-4 sm:-mx-6 lg:-mx-8 overflow-hidden group cursor-default">
				<div class="marquee-track flex w-max items-center group-hover:[animation-play-state:paused]">
					<div class="flex items-center gap-x-8 text-xs font-mono uppercase tracking-widest text-muted shrink-0 pr-8">
						{
							tickerItems.map((item) => (
								<>
									<span class="text-ink font-semibold">{item}</span>
									<span class="text-accent">✻</span>
								</>
							))
						}
					</div>
					<div class="flex items-center gap-x-8 text-xs font-mono uppercase tracking-widest text-muted shrink-0 pr-8" aria-hidden="true">
						{
							tickerItems.map((item) => (
								<>
									<span class="text-ink font-semibold">{item}</span>
									<span class="text-accent">✻</span>
								</>
							))
						}
					</div>
				</div>
			</section>

			<!-- Metrics Grid -->
			<section aria-label="Key Impact Metrics" class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 py-8 border-b border-line">
				{
					metrics.map((metric, index) => (
						<div class:list={[
							'space-y-4',
							index > 0 ? 'lg:border-l lg:border-line lg:pl-8' : '',
						]}>
							<div class="text-4xl sm:text-5xl lg:text-6xl font-normal font-serif italic text-ink tracking-tight leading-none">
								{metric.value}
							</div>
							<div class="flex items-center gap-2 text-[11px] sm:text-xs font-mono tracking-wider text-muted uppercase">
								<span class="text-accent font-semibold">—</span>
								<span>{metric.label}</span>
							</div>
						</div>
					))
				}
			</section>

			<!-- Core Competencies / Areas -->
			<section class="space-y-6 pt-4" aria-labelledby="expertise-heading">
				<div class="space-y-2">
					<div class="font-mono text-xs text-accent tracking-wide">
						&#40; capabilities &#41;
					</div>
					<h2 id="expertise-heading" class="text-2xl sm:text-3xl font-bold font-serif text-ink tracking-tight">
						Engineering Quality & Resilience
					</h2>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					{
						expertise.map((item) => (
							<article class="p-6 sm:p-8 rounded-2xl border border-line bg-paper-card space-y-4 flex flex-col justify-between">
								<div class="space-y-3">
									<h3 class="text-base font-semibold text-ink font-sans">
										{item.title}
									</h3>
									<p class="text-sm text-muted leading-relaxed font-sans">
										{item.description}
									</p>
								</div>
								<div class="flex flex-wrap gap-1.5 pt-2">
									{item.tags.map((tag) => (
										<span class="px-2 py-0.5 rounded-md bg-paper border border-line text-[11px] font-mono text-muted">
											{tag}
										</span>
									))}
								</div>
							</article>
						))
					}
				</div>
			</section>

			<!-- CTA Section -->
			<section
				class="p-8 sm:p-14 rounded-3xl border border-line bg-paper-card space-y-6 relative overflow-hidden"
				aria-labelledby="cta-heading"
			>
				<div class="space-y-2">
					<div class="font-mono text-xs text-accent tracking-wide">
						&#40; collaborate &#41;
					</div>
					<h2
						id="cta-heading"
						class="text-3xl sm:text-5xl font-bold font-serif text-ink tracking-tight"
					>
						Let’s build <span class="italic text-accent font-normal">bulletproof systems</span>
					</h2>
				</div>

				<p class="text-sm sm:text-base text-muted max-w-xl leading-relaxed">
					Whether you are setting up automated E2E testing from scratch, accelerating flaky CI/CD pipelines, or integrating AI-assisted quality workflows, I’d love to connect.
				</p>

				<div class="flex flex-wrap items-center gap-4 pt-2">
					<a
						href={`mailto:${EMAIL}`}
						class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-ink text-paper text-sm font-medium hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 transition-none"
					>
						<span>Get in Touch</span>
						<span>→</span>
					</a>
					<a
						href={LINKEDIN_URL}
						target="_blank"
						rel="noreferrer noopener"
						class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-line bg-paper text-ink text-sm font-medium hover:border-ink focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 transition-none"
					>
						<span>LinkedIn Profile</span>
						<span class="text-xs">↗</span>
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	@keyframes titleRotate {
		0%, 20% {
			transform: translateY(0%);
		}
		25%, 45% {
			transform: translateY(-20%);
		}
		50%, 70% {
			transform: translateY(-40%);
		}
		75%, 95% {
			transform: translateY(-60%);
		}
		100% {
			transform: translateY(-80%);
		}
	}

	.animate-rotate-titles {
		animation: titleRotate 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}

	@keyframes marquee {
		0% {
			transform: translateX(0%);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	.marquee-track {
		animation: marquee 22s linear infinite;
	}
</style>
